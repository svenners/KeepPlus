# KeepPlus Environment Configuration

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-32-character-secret-key-here

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# (Optional) Google Workspace Enterprise only - keep false for personal Gmail accounts
ENABLE_KEEP_ENTERPRISE_SCOPE=false
